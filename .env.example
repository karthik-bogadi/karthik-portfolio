# Copy this file to .env and fill in the values you want to use.
# Everything here is optional: without EmailJS the contact form falls back to
# opening the visitor's email app (mailto:) addressed to you.

# EmailJS (https://www.emailjs.com/) - sends contact form messages to your inbox
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable analytics.
VITE_GA_TRACKING_ID=
